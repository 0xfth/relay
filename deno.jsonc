{
  "name": "@xfth/relay",
  "version": "0.1.1",
  "exports": "./mod.ts",
  "description": "TypeScript library for relaying conversations with AI models.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xfth/relay.git"
  },
  "license": "CC0-1.0",
  "keywords": [
    "ai",
    "gemini",
    "llm",
    "conversation",
    "typescript",
    "deno",
    "relay"
  ],
  "tasks": {
    "test-watch": "deno test --watch -A test-watch.ts",
    "test-full": "deno test -A test-full.ts",
    "start-slot": "deno run --allow-net --allow-read --allow-env examples/run-hello-slot.ts",
    "start-agent": "deno run --allow-net test-agent.ts ws://localhost:8080",
    "test-integration": "echo 'Manual: Run start-slot in one terminal, start-agent in another'"
    // TODO: Automate integration test later if possible
  },
  "imports": {
    "@/": "./",
    "npm:uuid": "npm:uuid@^9.0.1" // Add uuid for request IDs
  }
}
